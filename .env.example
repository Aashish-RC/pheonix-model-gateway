# ==============================================================================
# ra1 Model Gateway — Environment Configuration
# ==============================================================================

# Server Configuration
PORT=4000
NODE_ENV=production

# ------------------------------------------------------------------------------
# Provider Credentials (Cloud Endpoints)
# ------------------------------------------------------------------------------

# OpenAI Official
OPENAI_API_KEY=sk-proj-...
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Google Gemini (AI Studio / Vertex)
GEMINI_API_KEY=AIzaSy...
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Amazon Bedrock (AWS SigV4)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...

# Google Cloud OAuth2 / Vertex
GCP_PROJECT_ID=my-gcp-project
# GCP_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ------------------------------------------------------------------------------
# Local Inference Engines (Zero API Cost & Escape Routes)
# ------------------------------------------------------------------------------

# Ollama Server
OLLAMA_BASE_URL=http://127.0.0.1:11434

# llama.cpp HTTP Server
LLAMA_CPP_BASE_URL=http://127.0.0.1:8080

# LocalAI
LOCALAI_BASE_URL=http://127.0.0.1:8080

# ------------------------------------------------------------------------------
# Telemetry, Metering & Rate Limiting
# ------------------------------------------------------------------------------
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RESPONSE_CACHE_ENABLED=false
RESPONSE_CACHE_TTL_MS=300000
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
